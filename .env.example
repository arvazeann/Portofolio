# Admin authentication (server-only; never add a NEXT_PUBLIC_ prefix)
ADMIN_USERNAME=
# Generated locally with: node scripts/hash-admin-password.mjs
ADMIN_PASSWORD_HASH=
# Random 32-byte base64url secret; generate locally with Node crypto.
# Example command: node -p "require('node:crypto').randomBytes(32).toString('base64url')"
ADMIN_SESSION_SECRET=

# Supabase content database (configured in a later CMS stage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only, least-privilege Postgres writer connection. Do not expose to client.
SUPABASE_DB_WRITER_URL=
